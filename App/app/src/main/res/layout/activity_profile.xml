<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="viewModel"
            type="com.example.assistant.viewmodel.ProfileViewModel" />
    </data>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_main"
        tools:context=".views.ProfileActivity"
        android:scrollbars="vertical">

        <ImageButton
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:id="@+id/backBtn"
            android:src="@drawable/back"
            android:scaleType="fitCenter"
            android:backgroundTint="@color/background_main"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textTt"
            android:text="Профиль"
            android:textSize="26dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:paddingVertical="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textTt"
            android:orientation="vertical"
            android:layout_marginHorizontal="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/profile"
                    android:scaleType="fitCenter"
                    android:backgroundTint="@color/background_main"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:id="@+id/userName"
                    android:layout_gravity="center"
                    android:textColor="@color/black"
                    android:textSize="22dp"
                    android:text="PersonName"
                    android:layout_marginLeft="10dp"
                    android:paddingHorizontal="5dp"
                    />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="15dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/email"
                    android:scaleType="fitCenter"
                    android:padding="2dp"
                    android:backgroundTint="@color/background_main"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:id="@+id/email"
                    android:layout_gravity="center"
                    android:textColor="@color/black"
                    android:textSize="22dp"
                    android:text="person@email.com"
                    android:layout_marginLeft="10dp"
                    android:paddingHorizontal="5dp"
                    />
            </LinearLayout>
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/exit"
            android:text="Выход из аккаунта"
            android:textSize="24dp"
            android:textColor="@color/black"
            android:layout_marginVertical="20dp"
            android:background="@drawable/image_btn_style"
            android:backgroundTint="@color/red"
            android:paddingHorizontal="50dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            />


    </RelativeLayout>
</layout>