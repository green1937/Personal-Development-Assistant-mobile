<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="3dp"
    android:layout_marginBottom="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/filter_bcg"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/startTimeEventTextOut"
            android:text="00:00"
            android:textSize="14dp"
            android:textColor="@color/black"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/somethingText"
            android:layout_toRightOf="@+id/startTimeEventTextOut"
            android:text=" - "
            android:textSize="14dp"
            android:textColor="@color/black"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/stopTimeEventTextOut"
            android:layout_toRightOf="@+id/somethingText"
            android:text="23:59"
            android:textSize="14dp"
            android:textColor="@color/black"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/stopTimeEventTextOut"
            android:layout_alignParentEnd="true"
            android:id="@+id/placeEventTextOut"
            android:textSize="14dp"
            android:layout_gravity="end"
            android:gravity="end"
            android:textColor="@color/black"
            android:text="кабинет 4-21" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/nameEventTextOut"
            android:layout_below="@+id/startTimeEventTextOut"
            android:text="Team Project"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="18dp"
            android:textStyle="bold"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/formatEventTextOut"
            android:layout_below="@+id/nameEventTextOut"
            android:text="offline/online"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="14dp"
            android:textStyle="italic"/>
    </RelativeLayout>



</RelativeLayout>