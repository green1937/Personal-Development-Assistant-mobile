<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="viewModel"
            type="com.example.assistant.viewmodel.LoginViewModel" />
    </data>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_main"
        tools:context=".SideMenuActivity"
        android:scrollbars="vertical"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingHorizontal="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Вход"
                android:textSize="26dp"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginVertical="10dp"
                android:textStyle="bold"/>


            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/email"
                android:hint="Введите email"
                android:textColor="@color/black"
                android:background="@drawable/image_btn_style"
                android:paddingVertical="5dp"
                android:paddingHorizontal="15dp"
                android:layout_marginVertical="7dp"
                android:backgroundTint="@color/white"
                android:text="@={viewModel.login.email}"
                />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/password"
                android:hint="Введите пароль"
                android:textColor="@color/black"
                android:background="@drawable/image_btn_style"
                android:paddingVertical="5dp"
                android:paddingHorizontal="15dp"
                android:layout_marginVertical="7dp"
                android:backgroundTint="@color/white"
                android:text="@={viewModel.login.password}"
                />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/login"
                    android:text="Войти"
                    android:textSize="24dp"
                    android:textColor="@color/black"
                    android:layout_marginVertical="20dp"
                    android:background="@drawable/image_btn_style"
                    android:backgroundTint="@color/bottom_menu"
                    android:onClick="@{()-> viewModel.onSaveBtnClicked()}"
                    android:paddingHorizontal="50dp"
                    />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/register"
            android:text="Зарегистрироваться"
            android:textSize="24dp"
            android:textColor="@color/black"
            android:layout_marginVertical="20dp"
            android:background="@drawable/image_btn_style"
            android:backgroundTint="@color/filter_bcg"
            android:paddingHorizontal="20dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"

            />


    </RelativeLayout>
</layout>