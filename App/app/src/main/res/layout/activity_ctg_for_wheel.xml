<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".CtgForWheelActivity"
    android:scrollbars="vertical">

    <ImageButton
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:id="@+id/backBtn"
        android:src="@drawable/back"
        android:scaleType="fitCenter"
        android:backgroundTint="@color/background_main"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/textPlans"
        android:text="Категории"
        android:textSize="26dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:paddingVertical="10dp"/>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/linL"
        android:orientation="horizontal"
        android:layout_below="@+id/backBtn"
        android:visibility="visible"
        android:layout_marginHorizontal="10dp">
        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:id="@+id/addCtgBtn"
            android:src="@drawable/add_ctg"
            android:scaleType="fitCenter"
            android:backgroundTint="@color/background_main"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textAdd"
            android:text="Добавить категорию"
            android:textSize="20dp"
            android:gravity="center_vertical"
            android:textColor="@color/black"
            android:paddingVertical="10dp"/>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/addCtgRelativeLayout"
        android:visibility="gone"
        android:background="@color/background2"
        android:layout_below="@+id/linL"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:id="@+id/colorNewCtg"
            android:layout_marginRight="10dp"
            android:background="@color/background2"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/nameNewCtg"
            android:layout_toRightOf="@+id/colorNewCtg"
            android:hint="Название категории"
            android:textColor="@color/black"
            android:textSize="18dp"/>

        <com.skydoves.colorpickerview.ColorPickerView
            android:id="@+id/colorPickerView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_below="@+id/nameNewCtg"
            android:layout_marginTop="10dp"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="20dp"/>


            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Закрыть"
                android:textAlignment="center"
                android:layout_alignParentLeft="true"
                android:id="@+id/closeBtn"
                android:layout_below="@+id/colorPickerView"
                android:backgroundTint="@color/red"
                android:background="@drawable/image_btn_style"
                android:layout_marginBottom="10dp"
                android:paddingHorizontal="30dp"
                android:textSize="18dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Сохранить"
                android:textAlignment="center"
                android:id="@+id/saveNewCtgBtn"
                android:layout_below="@+id/colorPickerView"
                android:layout_alignParentRight="true"
                android:backgroundTint="@color/green"
                android:background="@drawable/image_btn_style"
                android:layout_marginBottom="10dp"
                android:paddingHorizontal="30dp"
                android:textSize="18dp"
                android:textColor="@color/black"/>

    </RelativeLayout>




    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scroll"
        android:layout_below="@+id/addCtgRelativeLayout">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/allCtgRecyclerView"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"/>

        </RelativeLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/bottom_menu"
        style="@style/Widget.MaterialComponents.BottomNavigationView.Colored"
        app:itemIconTint="@color/black"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_menu"/>

</RelativeLayout>