<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="viewModel"
            type="com.example.assistant.ui.wheel.viewmodel.WheelViewModel" />
    </data>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".ui.wheel.view.WheelActivity"
    android:scrollbars="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="51dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textWheel"
            android:text="Колесо баланса"
            android:textSize="26dp"
            android:gravity="center_horizontal"
            android:textColor="@color/black"
            android:paddingVertical="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/linL"
            android:layout_below="@+id/textWheel"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дата"
                android:textSize="18dp"
                android:textColor="@color/black"/>
            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/dateWheelFrom"
                android:background="@drawable/image_btn_style"
                android:hint="дд.мм.гггг"
                android:paddingHorizontal="10dp"
                android:layout_marginHorizontal="20dp"
                android:textSize="18dp"
                android:textColor="@color/bottom_menu"
                android:onClick="setDateFrom"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="@color/black"
                android:textSize="18dp"/>

            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/dateWheelTo"
                android:background="@drawable/image_btn_style"
                android:hint="дд.мм.гггг"
                android:paddingHorizontal="10dp"
                android:layout_marginHorizontal="20dp"
                android:textSize="18dp"
                android:textColor="@color/bottom_menu"
                android:onClick="setDateTo"/>

        </LinearLayout>

        <com.example.assistant.ui.wheel.view.WheelView
            android:id="@+id/wheelView"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_below="@+id/linL" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/wheelView"
            android:divider="?android:attr/dividerHorizontal"
            android:showDividers="middle"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/allCtgLLtext"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Все категории"
                    android:textSize="20dp"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:layout_weight="1"/>
                <ImageButton
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:id="@+id/addNewCtg"
                    android:layout_gravity="end"
                    android:src="@drawable/add_ctg"
                    android:scaleType="centerCrop"
                    android:padding="3dp"
                    android:backgroundTint="@color/background_main"/>

            </LinearLayout>



            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/ctgRV"
                />
        </LinearLayout>
        </RelativeLayout>
    </ScrollView>







        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/bottom_menu"
            style="@style/Widget.MaterialComponents.BottomNavigationView.Colored"
            app:itemIconTint="@color/black"
            android:layout_alignParentBottom="true"
            app:menu="@menu/bottom_menu" />
    </RelativeLayout>
</layout>