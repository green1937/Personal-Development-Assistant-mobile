<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".MainActivity"
    android:scrollbars="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/textWheel"
        android:text="Колесо баланса"
        android:textSize="26dp"
        android:gravity="center_horizontal"
        android:textColor="@color/black"
        android:paddingVertical="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/linL"
        android:layout_below="@+id/textWheel"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дата"
            android:textSize="18dp"
            android:textColor="@color/black"/>
        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/dateWheelTo"
            android:background="@drawable/image_btn_style"
            android:hint="дд.мм.гггг"
            android:paddingHorizontal="10dp"
            android:layout_marginHorizontal="20dp"
            android:textSize="18dp"
            android:textColor="@color/bottom_menu" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/black"
            android:textSize="18dp"/>

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/dateWheelFrom"
            android:background="@drawable/image_btn_style"
            android:hint="дд.мм.гггг"
            android:paddingHorizontal="10dp"
            android:layout_marginHorizontal="20dp"
            android:textSize="18dp"
            android:textColor="@color/bottom_menu" />
    </LinearLayout>

    <com.example.assistant.wheel.WheelView
        android:id="@+id/wheelView"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_below="@+id/linL"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="49dp"
        android:layout_marginEnd="0dp" />

<!--    <com.github.mikephil.charting.charts.RadarChart-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:id="@+id/radarChart"-->
<!--        android:layout_marginHorizontal="10dp"-->
<!--        android:layout_marginBottom="60dp"-->
<!--        android:layout_below="@+id/linL"-->
<!--        />-->


        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/bottom_menu"
            style="@style/Widget.MaterialComponents.BottomNavigationView.Colored"
            app:itemIconTint="@color/black"


            android:layout_alignParentBottom="true"
            app:menu="@menu/bottom_menu"

            />
    </RelativeLayout>